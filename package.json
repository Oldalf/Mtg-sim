{
  "name": "mtg-goldfish-sim",
  "private": true,
  "description": "Goldfish simulator for Commander decks (shared engine + one folder per deck).",
  "scripts": {
    "build": "esbuild sim.ts --bundle --platform=node --format=cjs --target=node20 --sourcemap --log-level=warning --outfile=dist/sim.js",
    "sim": "npm run -s build && node --enable-source-maps dist/sim.js",
    "eco": "npm run -s build && node --enable-source-maps dist/sim.js --eco",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
